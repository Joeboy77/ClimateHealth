# ClimaHealth Predict — backend configuration
#
# Copy this file to .env and adjust. Every value has a working default, so the
# API runs with no .env at all. Never commit your real .env.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Security (REQUIRED IN PRODUCTION)
# ---------------------------------------------------------------------------

# Signing key for access tokens. Must be at least 32 bytes.
# The default in code is a known public string — override it before deploying.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CLIMAHEALTH_TOKEN_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# How long an access token stays valid, in hours.
CLIMAHEALTH_TOKEN_LIFETIME_HOURS=12

# ---------------------------------------------------------------------------
# Front ends
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call this API.
# 3000 is the Next.js dashboard, 8081 is the Expo dev server for Dawuro.
CLIMAHEALTH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# ---------------------------------------------------------------------------
# Local languages (optional)
# ---------------------------------------------------------------------------

# Free API key from https://translation.ghananlp.org/ — enables Twi, Ga, Ewe and
# Dagbani forecasts via GET /forecast/{id}?language=tw
# Leave blank and the API still works, returning English.
CLIMAHEALTH_GHANA_NLP_API_KEY=

# ---------------------------------------------------------------------------
# Climate feed (optional)
# ---------------------------------------------------------------------------

# How long derived Open-Meteo features are cached per district, in minutes.
# Open-Meteo updates hourly, so 30 is a sensible default. Set 0 to disable.
CLIMAHEALTH_CLIMATE_CACHE_MINUTES=30

# ---------------------------------------------------------------------------
# Persistence (optional)
# ---------------------------------------------------------------------------

# Postgres connection string. Leave blank and every store runs in memory,
# which means reports, action statuses and the transition log reset on restart.
#   createdb climahealth
CLIMAHEALTH_DATABASE_URL=postgresql+psycopg://USER@localhost:5432/climahealth

# Moolre SMS and USSD. Sending is off by default: set to live only when you intend
# real messages to leave. Get the VAS key from the Moolre dashboard.
CLIMAHEALTH_SMS_DELIVERY=preview
CLIMAHEALTH_MOOLRE_BASE_URL=https://api.moolre.com
CLIMAHEALTH_MOOLRE_VASKEY=
# Must be a sender ID approved on your Moolre account. Check it with
# POST /open/sms/query {"type":1,"senderid":"..."} before a broadcast.
CLIMAHEALTH_MOOLRE_SENDER_ID=Klare
CLIMAHEALTH_MOOLRE_USSD_EXTENSION=

# Lets a phone on the same Wi-Fi reach this server during development. The app infers the
# API host from the Expo dev server's address, which is a private one. Never enable in
# production. Run uvicorn with --host 0.0.0.0 as well, or nothing outside this machine
# can connect at all.
CLIMAHEALTH_ALLOW_LOCAL_NETWORK_ORIGINS=false

# Mobile money payouts through Moolre. Never set to live in a shared environment.
CLIMAHEALTH_PAYOUT_MODE=preview
CLIMAHEALTH_MOOLRE_API_USER=
CLIMAHEALTH_MOOLRE_API_KEY=
CLIMAHEALTH_MOOLRE_ACCOUNT_NUMBER=

# Cloudinary, for community report photos. Without these, photos are stored on
# local disk instead and everything else works unchanged.
CLIMAHEALTH_CLOUDINARY_CLOUD_NAME=
CLIMAHEALTH_CLOUDINARY_API_KEY=
CLIMAHEALTH_CLOUDINARY_API_SECRET=
CLIMAHEALTH_CLOUDINARY_FOLDER=climahealth/reports
