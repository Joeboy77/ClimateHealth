    "geist": "^1.3.1",
    "next": "^15.1.0",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "d3-geo": "^3.1.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "openapi-typescript": "^7.4.4",
