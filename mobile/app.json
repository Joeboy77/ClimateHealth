{
  "expo": {
    "name": "Dawuro",
    "slug": "dawuro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gh.climahealth.dawuro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A3B35",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "gh.climahealth.dawuro"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0A3B35",
          "resizeMode": "contain",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-audio"
    ],
    "scheme": "dawuro",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0A3B35",
    "splash": {
      "backgroundColor": "#0A3B35",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61c992d3-4c01-4ed1-93ef-b822dbd8eb38"
      }
    }
  }
}
